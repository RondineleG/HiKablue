# Copy to /etc/hikablue/control.env and edit on the control-plane host.
# Values are intentionally blank/placeholders: provision real secrets outside git
# with your secret manager or a root-owned, mode-0600 override file.
ASPNETCORE_URLS=https://127.0.0.1:7443
VpnControl__ConnectionString=
VpnControl__HeartbeatToken=
VpnControl__AdminToken=
VpnControl__SessionTokenSecret=
VpnControl__IpPoolCidr=10.80.1.128/25
VpnControl__SessionTtlSeconds=3600
Kestrel__Certificates__Default__Path=/etc/hikablue/pki/server.crt
Kestrel__Certificates__Default__KeyPath=/etc/hikablue/pki/server.key
VpnControl__LabCaPath=/etc/hikablue/pki/ca.crt
