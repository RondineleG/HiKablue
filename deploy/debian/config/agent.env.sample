# Copy to /etc/hikablue/agent.env and edit for the isolated lab node.
# Certificate files are configured by path; do not paste private keys here.
CONTROL_ORCHESTRATOR=127.0.0.1:7443
NODE_ID=change-me-node-id
AGENT_VERSION=dev
CA_PATH=/etc/hikablue/pki/ca.crt
CERT_PATH=/etc/hikablue/pki/node.crt
KEY_PATH=/etc/hikablue/pki/node.key
