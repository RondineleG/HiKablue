[Unit]
Description=HiKablue control plane
Documentation=https://github.com/RondineleG/HiKablue
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=hikablue-control
Group=hikablue-control
EnvironmentFile=-/etc/hikablue/control.env
LoadCredentialEncrypted=connection-string:/etc/hikablue/credentials/control/current/connection-string
LoadCredentialEncrypted=heartbeat-token:/etc/hikablue/credentials/control/current/heartbeat-token
LoadCredentialEncrypted=admin-token:/etc/hikablue/credentials/control/current/admin-token
LoadCredentialEncrypted=session-token-secret:/etc/hikablue/credentials/control/current/session-token-secret
LoadCredentialEncrypted=server.crt:/etc/hikablue/credentials/control/current/server.crt
LoadCredentialEncrypted=server.key:/etc/hikablue/credentials/control/current/server.key
LoadCredentialEncrypted=lab-ca.crt:/etc/hikablue/credentials/control/current/lab-ca.crt
ExecStart=/opt/hikablue/current/bin/hikablue-control-service
Restart=on-failure
RestartSec=2s
LimitNOFILE=8192
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
