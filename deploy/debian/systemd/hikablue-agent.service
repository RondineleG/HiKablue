[Unit]
Description=HiKablue node orchestration agent
Documentation=https://github.com/RondineleG/HiKablue
After=hikablue-engine.service network-online.target
Requires=hikablue-engine.service
PartOf=hikablue-engine.service
Wants=network-online.target

[Service]
Type=simple
User=hikablue-agent
Group=hikablue-agent
EnvironmentFile=-/etc/hikablue/agent.env
LoadCredentialEncrypted=lab-ca.crt:/etc/hikablue/credentials/node/current/lab-ca.crt
LoadCredentialEncrypted=node.crt:/etc/hikablue/credentials/node/current/node.crt
LoadCredentialEncrypted=node.key:/etc/hikablue/credentials/node/current/node.key
ExecStart=/opt/hikablue/current/bin/hikablue-agent-service
Restart=always
RestartSec=1s
LimitNOFILE=4096
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hikablue/agent-state
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
